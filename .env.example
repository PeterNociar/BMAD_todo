# Compose profiles to run. "app" is the everyday app; "test" adds db-test for pytest.
COMPOSE_PROFILES=app

# Host address the app is published on (port 8080). 127.0.0.1 keeps it local;
# set a Tailscale IP to reach it from a phone (see README).
APP_BIND=127.0.0.1

# Postgres credentials and database for the "app" profile.
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# Backend connection string (sync psycopg driver).
DATABASE_URL=postgresql+psycopg://todo:todo@db:5432/todo

# nginx upstream for /api, host:port with no scheme.
API_UPSTREAM=backend:8000

# Used by pytest in backend/ (db-test, published on 127.0.0.1:5433).
TEST_DATABASE_URL=postgresql+psycopg://todo:todo@127.0.0.1:5433/todo_pytest

# Base URL the Playwright suite in e2e/ runs against.
E2E_BASE_URL=http://127.0.0.1:8080
