# Compose profiles to run (comma-separated). See README "Compose profiles".
#   app  - everyday app: db, backend, frontend               -> 127.0.0.1:8081 (APP_BIND)
#   dev  - hot reload: db, backend-dev, frontend-dev (Vite)  -> 127.0.0.1:8000, 127.0.0.1:5173
#   test - db-test (pytest + E2E), backend-test, frontend-test -> 127.0.0.1:5436, 127.0.0.1:8082
# A shell COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=test docker compose up) overrides this.
COMPOSE_PROFILES=app

# Host address the app is published on (port 8081). 127.0.0.1 keeps it local;
# set a Tailscale IP to reach it from a phone (see README).
APP_BIND=127.0.0.1

# Postgres credentials and database for the "app" profile.
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# Backend connection string (sync psycopg driver), used by backend and backend-dev.
# backend-test always uses db-test/todo_e2e, set in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://todo:todo@db:5432/todo

# Backend mode: "app" (default) or "test". "test" mounts the /api/test/* seeding and
# clock router. Listed because this file lists every variable; this root .env only feeds
# compose interpolation, and compose sets APP_ENV per backend service (backend and
# backend-dev: app, backend-test: test). For local runs, set it in backend/.env.
APP_ENV=app

# /api upstream for the app profile's nginx, host:port with no scheme. frontend-dev
# (Vite, backend-dev:8000) and frontend-test (nginx, backend-test:8000) are fixed in compose.
API_UPSTREAM=backend:8000

# Used by pytest in backend/ (db-test, published on 127.0.0.1:5436).
TEST_DATABASE_URL=postgresql+psycopg://todo:todo@127.0.0.1:5436/todo_pytest

# The two E2E_* variables are listed here only for completeness: nothing loads .env
# into Playwright, so set them in the shell, e.g. `E2E_BROWSER_CHANNEL=chrome npm test`.
#
# Base URL the Playwright suite in e2e/ runs against: the test profile on :8082
# (COMPOSE_PROFILES=test docker compose up -d --build --wait). The suite runs with one worker.
E2E_BASE_URL=http://127.0.0.1:8082

# Optional: run an installed browser instead of Playwright's bundled Chromium, e.g. "chrome".
# Empty uses the bundled Chromium.
E2E_BROWSER_CHANNEL=
