server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 64k;
    server_tokens off;

    # A location that sets its own add_header drops these, so every static location repeats them.
    # X-Frame-Options (with the CSP's frame-ancestors on static files) stops another site from
    # framing the app or /api/docs and tricking clicks on it (clickjacking; story 3.8).
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
        # Docker's DNS, re-asked every 10 s: a recreated backend gets a new IP, and a
        # proxy_pass with a literal host would keep the startup IP (502) until a restart.
        # A variable forces the runtime lookup; with no URI part the path passes unchanged.
        # Side effects: this relies on Docker's embedded DNS (a compose user-defined network),
        # and /etc/hosts entries are not consulted. An unresolvable backend no longer stops
        # nginx starting: nginx stays healthy and each /api request gets a 502, which the
        # client maps to `unavailable` (and rolls back).
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api http://${API_UPSTREAM};
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static files. Every location below sets its own add_header, so each repeats the shared
    # headers and the CSP (AD-16, AD-19).
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
        try_files $uri $uri/ /index.html;
    }

    # The page itself: `/` (through `index`) and every deep link (through try_files) redirect
    # internally here. no-cache: always revalidated, so a rebuild's new asset hashes are seen.
    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-cache" always;
    }

    # The render-blocking pre-paint script has a fixed, unhashed URL: never run a stale copy.
    location = /theme-init.js {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-cache" always;
    }

    # Vite's content-hashed bundle: a changed file gets a new name, so cache it for a year.
    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
        # No `always`: a missing asset's 404 must not be cached as immutable.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}
